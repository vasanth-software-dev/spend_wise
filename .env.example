# ==============================================================================
# SPENDWISE - ENVIRONMENT CONFIGURATION
# Product: SpendWise - "Understand where your money goes."
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173

# Database & Cache
# If using Docker compose: mongodb://localhost:27017/spendwise
MONGO_URI=mongodb://localhost:27017/spendwise
# Optional Redis connection (gracefully degrades to in-memory store if unavailable)
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Generate secure keys in production: openssl rand -base64 32
JWT_ACCESS_SECRET=spendwise_super_secret_access_token_key_change_in_production_min32chars
JWT_REFRESH_SECRET=spendwise_super_secret_refresh_token_key_change_in_production_min32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM Encryption Key for OAuth Tokens & sensitive data (Must be exactly 32 bytes / 64 hex chars or 32 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth & Gmail API (Optional for dev mock provider, required for live Gmail sync)
# Never commit credentials or expose secrets to client
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/email-accounts/gmail/callback

# Email Notification SMTP (Optional abstraction)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SpendWise <no-reply@spendwise.local>

# Ports for Docker Compose services
MONGO_PORT=27017
REDIS_PORT=6379
MONGO_EXPRESS_PORT=8081
REDIS_COMMANDER_PORT=8082
