{
  "name": "spendwise",
  "version": "1.0.0",
  "description": "Enterprise-Quality Personal Expense Tracker Web Application focused on Indian users and UPI transactions",
  "author": "SpendWise Team",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=spendwise-server",
    "dev:client": "npm run dev --workspace=spendwise-client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=spendwise-server",
    "build:client": "npm run build --workspace=spendwise-client",
    "start": "npm run start --workspace=spendwise-server",
    "seed": "npm run seed --workspace=spendwise-server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=spendwise-server",
    "test:client": "npm run test --workspace=spendwise-client",
    "lint": "npm run lint --workspace=spendwise-server && npm run lint --workspace=spendwise-client"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fast-csv": "^5.0.1",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@vercel/node": "^3.2.0",
    "concurrently": "^8.2.2"
  }
}
